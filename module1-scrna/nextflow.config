docker.enabled = false // local R install used by default

params {
    // --- Input data (Wu et al. 2021, GSE176078) ---
    matrix_mtx   = "${projectDir}/../data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/count_matrix_sparse.mtx"
    genes_tsv    = "${projectDir}/../data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/count_matrix_genes.tsv"
    barcodes_tsv = "${projectDir}/../data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/count_matrix_barcodes.tsv"
    metadata_csv = "${projectDir}/../data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/metadata.csv"

    // --- Which patient to analyze (shared across all 6 modules) ---
    patient_id = "CID44971"

    // --- QC thresholds (namespaced: scrna_* to avoid collision with
    //     Module 2's spatial QC thresholds under the master pipeline) ---
    scrna_min_features = 200
    scrna_max_features = 6000
    scrna_max_mito     = 20

    // --- Clustering ---
    scrna_npcs = 30
    resolutions = [0.5, 0.3, 0.2, 0.1]

    // --- Output (namespaced: scrna_outdir, so this module's results
    //     never collide with another module's when run under the
    //     master pipeline) ---
    scrna_outdir = "results"
}

process {
    resourceLimits = [
        cpus  : 4,
        memory: '12.GB',
        time  : '2.h'
    ]
}

manifest {
    name        = 'module1-scrna'
    description = 'scRNA-seq QC, resolution-swept clustering, and marker-validated annotation for a single Wu et al. 2021 breast cancer patient'
    author      = 'Sinduja Chandrasekaran'
}
