docker.enabled = false // local R/Seurat install, same as modules 1-2

params {
    // --- Inputs: outputs from Module 1 (scRNA reference) and Module 2 (spatial) ---
    scrna_object    = "${projectDir}/../module1-scrna/results/08_final/final_annotated.rds"
    scrna_markers   = "${projectDir}/../module1-scrna/results/07_markers/all_cluster_markers.csv"
    cluster_labels  = "${projectDir}/../module1-scrna/results/08_final/cluster_labels.csv"
    spatial_object  = "${projectDir}/../module2-spatial/results/06_investigate/investigated_spatial.rds"

    patient_id = "CID44971"

    // Number of top marker genes per cell type used for the marker-scoring method
    n_marker_genes = 20

    deconvolution_outdir = "results"
}

process {
    resourceLimits = [
        cpus  : 4,
        memory: '12.GB',
        time  : '2.h'
    ]
}

manifest {
    name        = 'module3-deconvolution'
    description = 'Cell-type deconvolution of spatial spots using the Module 1 scRNA-seq reference, via two independent methods (anchor-based label transfer and marker-gene scoring)'
    author      = 'Sinduja Chandrasekaran'
}
