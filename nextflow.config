docker.enabled = true // enables Docker for the one process (RUN_INFERCNV)
                        // that declares a container; all other processes
                        // run locally regardless, since only a process
                        // that explicitly declares `container` actually
                        // uses one.

params {
    // --- Shared across all modules ---
    patient_id = "CID44971"

    // --- Module 1: scRNA-seq reference (Wu et al. 2021, GSE176078) ---
    scrna_matrix_mtx    = "${projectDir}/data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/count_matrix_sparse.mtx"
    scrna_genes_tsv     = "${projectDir}/data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/count_matrix_genes.tsv"
    scrna_barcodes_tsv  = "${projectDir}/data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/count_matrix_barcodes.tsv"
    scrna_metadata_csv  = "${projectDir}/data/raw/scrnaseq/Wu_etal_2021_BRCA_scRNASeq/metadata.csv"
    scrna_resolutions   = [0.5, 0.3, 0.2, 0.1]
    scrna_min_features  = 200
    scrna_max_features  = 6000
    scrna_max_mito      = 20
    scrna_npcs          = 30
    scrna_outdir        = "results/module1-scrna"

    // --- Module 2: Visium spatial data ---
    spatial_spaceranger_dir = "${projectDir}/data/raw/spatial/CID44971_outs"
    spatial_metadata_csv    = "${projectDir}/data/raw/spatial/metadata/CID44971_metadata.csv"
    spatial_resolutions     = [0.8, 0.5, 0.3, 0.1]
    spatial_min_features    = 200
    spatial_max_mito        = 20
    spatial_npcs            = 30
    spatial_outdir          = "results/module2-spatial"

    // --- Module 3: deconvolution ---
    n_marker_genes       = 20
    deconvolution_outdir = "results/module3-deconvolution"

    // --- Module 4: CNV inference ---
    ref_groups       = "Normal + stroma + lymphocytes,Stroma,Stroma + adipose tissue"
    malignant_groups = "DCIS,Invasive cancer + lymphocytes"
    cnv_cutoff       = 0.1
    num_threads      = 4
    cnv_outdir       = "results/module4-cnv"

    // --- Module 5: spatial statistics ---
    k_neighbors          = 6
    n_permutations       = 999
    spatial_stats_outdir = "results/module5-spatial-stats"

    // --- Module 6: cell-cell communication ---
    cellchat_scalefactors_json = "${projectDir}/data/raw/spatial/CID44971_outs/spatial/scalefactors_json.json"
    min_cells                  = 10
    cellchat_outdir            = "results/module6-cellchat"
}

process {
    resourceLimits = [
        cpus  : 6,
        memory: '16.GB',
        time  : '8.h'
    ]
}

manifest {
    name        = 'spatial-tumor-project-master'
    description = 'Master pipeline: end-to-end tumor spatial architecture analysis (CID44971, TNBC) across all 6 modules, composed as real subworkflows with explicit channel data flow'
    author      = 'Sinduja Chandrasekaran'
}
