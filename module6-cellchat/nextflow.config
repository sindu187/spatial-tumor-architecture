docker.enabled = false // installed via conda binary (dnachun::r-cellchat)

params {
    // Uses Module 3's deconvolution output (has predicted.id per spot)
    deconvolved_object = "${projectDir}/../module3-deconvolution/results/04_final/final_deconvolved.rds"
    scalefactors_json  = "${projectDir}/../data/raw/spatial/CID44971_outs/spatial/scalefactors_json.json"
    patient_id         = "CID44971"

    min_cells = 10  // minimum spots per group for a communication result to be kept

    cellchat_outdir = "results"
}

process {
    resourceLimits = [
        cpus  : 4,
        memory: '16.GB',
        time  : '3.h'
    ]
}

manifest {
    name        = 'module6-cellchat'
    description = 'Cell-cell communication analysis (CellChat) between predicted cell-type groups, focused on tumor-immune/stromal signaling axes relevant to TNBC'
    author      = 'Sinduja Chandrasekaran'
}
