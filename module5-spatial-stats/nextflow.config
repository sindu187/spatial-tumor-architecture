docker.enabled = false // standard R packages, local install

params {
    // Uses Module 4's final output (spatial object with cnv_score attached)
    spatial_object = "${projectDir}/../module4-cnv/results/05_final/final_cnv_annotated.rds"
    patient_id     = "CID44971"

    k_neighbors  = 6     // Visium's hex grid gives each interior spot 6 neighbors
    n_permutations = 999 // for the Monte Carlo (permutation-based) Moran's I test

    spatial_stats_outdir = "results"
}

process {
    resourceLimits = [
        cpus  : 2,
        memory: '8.GB',
        time  : '1.h'
    ]
}

manifest {
    name        = 'module5-spatial-stats'
    description = 'Formal spatial autocorrelation testing (Moran\'s I) of CNV signal, to test whether malignant signal is spatially clustered or randomly scattered'
    author      = 'Sinduja Chandrasekaran'
}
