docker.enabled = true

params {
    // Module 4 depends only on Module 2's output -- CNV inference doesn't
    // need the deconvolution results from Module 3.
    spatial_object = "${projectDir}/../module2-spatial/results/06_investigate/investigated_spatial.rds"
    patient_id     = "CID44971"

    // Pathology categories used as the "normal" baseline vs. the
    // malignant populations we're testing for CNV signal against.
    // Passed as comma-separated strings (Nextflow params are simple
    // types; R scripts split on "," internally).
    ref_groups       = "Normal + stroma + lymphocytes,Stroma,Stroma + adipose tissue"
    malignant_groups = "DCIS,Invasive cancer + lymphocytes"

    // inferCNV settings
    cnv_cutoff  = 0.1   // recommended threshold for 10x/Visium-density data
    num_threads = 4

    cnv_outdir = "results"
}

process {
    resourceLimits = [
        cpus  : 4,
        memory: '16.GB',
        time  : '6.h'   // inferCNV can be slow, especially without HMM disabled it would be worse
    ]
}

manifest {
    name        = 'module4-cnv'
    description = 'Spatial CNV inference (inferCNV) with quantitative validation against pathologist-annotated malignant/normal regions'
    author      = 'Sinduja Chandrasekaran'
}
