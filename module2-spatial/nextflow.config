docker.enabled = false // local R/Seurat install, same as module1-scrna

params {
    // --- Input: Space Ranger output + pathology ground truth ---
    spaceranger_dir = "${projectDir}/../data/raw/spatial/CID44971_outs"
    metadata_csv    = "${projectDir}/../data/raw/spatial/metadata/CID44971_metadata.csv"
    patient_id      = "CID44971"

    // --- QC thresholds (namespaced: spatial_* to avoid collision with
    //     Module 1's scRNA QC thresholds under the master pipeline) ---
    spatial_min_features = 200
    spatial_max_mito     = 20

    // --- Clustering ---
    spatial_npcs = 30
    resolutions  = [0.8, 0.5, 0.3, 0.1]

    // --- Output (namespaced) ---
    spatial_outdir = "results"
}

process {
    resourceLimits = [
        cpus  : 4,
        memory: '12.GB',
        time  : '2.h'
    ]
}

manifest {
    name        = 'module2-spatial'
    description = 'Custom Nextflow pipeline for Visium spatial QC, SCTransform, resolution-swept clustering, and validation against pathologist annotations'
    author      = 'Sinduja Chandrasekaran'
}
